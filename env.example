# Model of .env (never commit .env). Scripts fill the chain part for you.
# Legacy names still accepted: KORKO_CLE_OPERATEUR, KORKO_CONTRAT, KORKO_MODE=equipe, KORKO_RPC...
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
EXPLORER_URL=https://testnet.snowtrace.io
OPERATOR_KEY=0x...        # created by python -m backend.chain.scripts.create_wallet
CONTRACT_ADDRESS=0x...    # your personal dev contract, added by backend.chain.scripts.deploy
CHAIN_MODE=auto           # auto, team (demo on the team contract), personal, fake, off
SECRET_KEY=change-me      # signs customer tokens
OPERATOR_PIN=             # optional PIN for the operator and partner pages
DEMO_MODE=1               # shows the SMS code on screen and the demo SMS inbox
ALARM_SOUND=1             # theft alarm sound on this computer
ANTHROPIC_API_KEY=        # optional: return photo diagnosis by Claude vision (otherwise simulated)
PHOTO_AI=auto             # auto (Claude if a key is set), claude, fake
